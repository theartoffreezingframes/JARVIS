# ---------------------------------------------------------------------------
# JARVIS API — environment template
#
# Copy to `.env` (gitignored) or export these variables in your process manager.
# Nothing here is required in development: the API runs with safe defaults and a
# random per-boot JWT secret. In production the two variables marked REQUIRED
# must be set or the server refuses to start.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Alternative port variable (JARVIS_API_PORT is only consulted if PORT is unset).
# JARVIS_API_PORT=4000
# Bind address. Keep 0.0.0.0 behind a reverse proxy or container network.
JARVIS_API_HOST=0.0.0.0
# REQUIRED in production: at least 32 characters, random, never committed.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JARVIS_JWT_SECRET=
# Public HTTPS origin of this API. Used for password-reset links.
JARVIS_PUBLIC_URL=https://api.example.com
# REQUIRED once you serve the web build from a different origin than the API.
# Comma-separated exact origins, e.g. https://app.example.com,https://www.example.com
JARVIS_ALLOWED_ORIGINS=
# Set to true only when a trusted reverse proxy/load balancer sits in front of
# the API (needed for correct client IPs in rate limiting and logs).
JARVIS_TRUST_PROXY=true
JARVIS_LOG_LEVEL=info
# Development only: set to false to stop the API returning reset tokens directly
# when no mail provider is configured. Ignored in production.
# JARVIS_EXPOSE_DEV_SECRETS=true
# Development only: overrides the random per-boot dev signing secret.
# JARVIS_DEV_SECRET=

# --- storage (SQLite) ------------------------------------------------------
# Persistent directory for the database and backups. Anything inside a
# container image is destroyed on redeploy — mount a volume here.
JARVIS_DATA_DIR=/var/lib/jarvis
# Optional explicit overrides; defaults are <JARVIS_DATA_DIR>/jarvis.sqlite
JARVIS_DB_FILE=
JARVIS_BACKUP_DIR=

# --- sign-in methods -------------------------------------------------------
# Email + password is always available. Google Sign-In is enabled only when at
# least one OAuth client id is listed here; without it the API answers
# POST /api/auth/google with 503 and the app hides the button (it never offers a
# sign-in method that cannot work).
#
# Client ids are public identifiers, not secrets — the app ships them. Never put
# a Google client *secret* here: the API verifies ID tokens against Google's
# published JWKS and needs no secret at all.
# Comma-separated; include every client id the app may present (Android, iOS, web).
JARVIS_GOOGLE_CLIENT_IDS=

# --- sessions --------------------------------------------------------------
JARVIS_ACCESS_TTL=7200
JARVIS_REFRESH_TTL_DAYS=60
# Production always uses 1. Only test suites raise it.
JARVIS_RATE_LIMIT_MULTIPLIER=1

# --- password-reset email (optional but needed for real users) -------------
# smtp | http | leave empty to disable delivery
JARVIS_EMAIL_PROVIDER=smtp
JARVIS_EMAIL_FROM=JARVIS <no-reply@example.com>
JARVIS_EMAIL_REPLY_TO=
# Abort a provider request that takes longer than this (ms).
JARVIS_EMAIL_TIMEOUT_MS=10000
# SMTP (works with any mail server / transactional provider)
JARVIS_SMTP_HOST=smtp.example.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_SECURE=false
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_SMTP_REQUIRE_TLS=true
# HTTP provider (Resend / SendGrid / Postmark / generic JSON gateway)
JARVIS_EMAIL_API_URL=
JARVIS_EMAIL_API_KEY=
# resend | sendgrid | postmark | generic
JARVIS_EMAIL_API_VENDOR=resend

# --- realtime --------------------------------------------------------------
# WebSocket heartbeat interval in ms (5s-60s). Keep the proxy read timeout above it.
JARVIS_REALTIME_HEARTBEAT_MS=15000

# --- remote push (optional; Expo push service, no secrets needed) ----------
JARVIS_PUSH_ENABLED=true
# Timeout for a push/receipt request in ms.
JARVIS_PUSH_TIMEOUT_MS=5000
JARVIS_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
JARVIS_PUSH_RECEIPT_ENDPOINT=https://exp.host/--/api/v2/push/getReceipts
# Only for Expo projects with push security enabled.
JARVIS_PUSH_ACCESS_TOKEN=

# --- mobile client (build time, not read by the API) ------------------------
# Inlined into the APK/bundle by Expo. It is public by definition — never put a
# secret in an EXPO_PUBLIC_* variable. A release build without it shows
# "Server not configured" instead of silently calling localhost.
# EXPO_PUBLIC_API_URL=https://api.example.com

# --- static web build (optional) -------------------------------------------
# Point this at the exported Expo web build to serve the app from the API.
JARVIS_WEB_ROOT=

# ---------------------------------------------------------------------------
# Mobile app (build-time public configuration)
#
# EXPO_PUBLIC_* values are inlined into the JS bundle and are PUBLIC by
# definition. Never put a secret here: no API keys, no SMTP credentials, no
# JWT secret, no Firebase private key.
# ---------------------------------------------------------------------------
# Public HTTPS origin of the deployed API. REQUIRED for a release build: without
# it the app refuses to guess and shows a configuration error instead of calling
# localhost.
EXPO_PUBLIC_API_URL=https://api.example.com
# Google Sign-In (optional). The Android client id must be registered in Google
# Cloud Console with the package name app.jarvis.mobile and the SHA-1 of the
# signing certificate you actually release with (see docs/RELEASE.md).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Only the native apps run the Google flow; the web build leaves it hidden.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Override only if your Google OAuth client uses a different redirect scheme.
# Defaults to com.googleusercontent.apps.<client-id>:/oauth2redirect
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
